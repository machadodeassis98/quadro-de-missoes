# Copie para .env.local e preencha com os dados do SEU projeto Supabase.
# .env.local está no .gitignore — nunca comite credenciais reais.
#
# Onde achar: painel do Supabase > Project Settings > API
#   Project URL         -> NEXT_PUBLIC_SUPABASE_URL
#   Project API keys    -> anon / public -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# A anon key é pública por natureza (vai para o navegador). Quem protege os
# dados é a Row Level Security, não o segredo da chave. NUNCA use a
# service_role key aqui: ela ignora toda a RLS.

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
