# Copie para .env.local e preencha com os dados do SEU projeto Supabase.
# .env.local está no .gitignore — nunca comite credenciais reais.
#
# Onde achar: painel do Supabase > Project Settings > API
#   Project URL                        -> SUPABASE_URL
#   Project API keys > anon / public   -> SUPABASE_ANON_KEY
#
# Cole APENAS o valor: sem repetir o nome da variável, sem aspas.
#
# Estes dois valores chegam ao navegador — é inevitável num app que fala
# direto com o Supabase pelo cliente. A anon key é feita para isso: quem
# protege os dados é a Row Level Security, não o segredo da chave.
#
# NUNCA use a service_role key aqui: ela ignora toda a RLS.

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key

# Compatibilidade: os nomes com prefixo NEXT_PUBLIC_ também funcionam, mas
# a Vercel classifica variáveis com esse prefixo como públicas e nem sempre
# permite criá-las. Prefira os nomes acima.
#   NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só para rodar migrations (npm run migrate) e os testes de integração.
# Supabase > Connect > Session pooler. Codifique caracteres especiais da
# senha: # -> %23, $ -> %24, ? -> %3F, @ -> %40
#   DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
